# ── 7. CHARTS: PRICE + TMO WITH SIGNALS ──────────────────────────────────────
def plot_symbol(sym: str, last_n: int = 150):
    if sym not in symbol_store:
        return
    d    = symbol_store[sym]
    df   = d['df'].tail(last_n).copy()
    main = d['main'].reindex(df.index)
    sig  = d['signal'].reindex(df.index)
    buys = d['buy_sigs'].reindex(df.index).fillna(False)
    sels = d['sell_sigs'].reindex(df.index).fillna(False)

    fig, axes = plt.subplots(2, 1, figsize=(16, 9), sharex=True,
                             gridspec_kw={'height_ratios': [3, 2]})
    fig.patch.set_facecolor('#0e1117')
    for ax in axes:
        ax.set_facecolor('#0e1117')
        ax.tick_params(colors='#cccccc', labelsize=8)
        for spine in ax.spines.values():
            spine.set_edgecolor('#333333')
    fig.suptitle(f'{sym}  —  TMO Backtest  |  last {last_n} trading days',
                 color='white', fontsize=13, fontweight='bold', y=0.98)

    x = np.arange(len(df))
    dates = df.index

    # ─ price ─
    ax1 = axes[0]
    ax1.plot(x, df['Close'], color='#a8c4e0', linewidth=1.2, label='Close', zorder=3)

    buy_x  = x[buys.values]
    sell_x = x[sels.values]
    buy_y  = df['Close'].values[buys.values]
    sell_y = df['Close'].values[sels.values]

    ax1.scatter(buy_x,  buy_y,  marker='^', color='#00e676', s=90, zorder=5, label='BUY signal')
    ax1.scatter(sell_x, sell_y, marker='v', color='#ff5252', s=90, zorder=5, label='SELL signal')
    for bx in buy_x:
        ax1.axvline(bx, color='#00e676', alpha=0.12, linewidth=1)
    for sx in sell_x:
        ax1.axvline(sx, color='#ff5252', alpha=0.12, linewidth=1)

    ax1.set_ylabel('Price', color='#cccccc', fontsize=9)
    ax1.legend(facecolor='#1a1d23', edgecolor='#444', labelcolor='white',
               fontsize=8, loc='upper left')
    ax1.yaxis.set_major_formatter(mticker.FormatStrFormatter('%.2f'))
    ax1.grid(color='#222222', linewidth=0.5)

    # ─ TMO ─
    ax2 = axes[1]
    main_v = main.values
    sig_v  = sig.values

    # colour-coded Main line (green above signal, red below)
    for i in range(len(x) - 1):
        col = '#00e676' if main_v[i] >= sig_v[i] else '#ff5252'
        ax2.plot(x[i:i+2], main_v[i:i+2], color=col, linewidth=1.8)

    ax2.plot(x, sig_v, color='#aaaaaa', linewidth=1, linestyle='--', alpha=0.7, label='Signal')

    # zone fills
    ax2.fill_between(x,  OB_LEVEL, TMO_LENGTH,
                     color='#ff525230', label=f'Overbought (>{OB_LEVEL})')
    ax2.fill_between(x, -TMO_LENGTH, OS_LEVEL,
                     color='#00e67630', label=f'Oversold (<{OS_LEVEL})')

    ax2.axhline(OB_LEVEL, color='#555555', linewidth=0.8, linestyle=':')
    ax2.axhline(OS_LEVEL, color='#555555', linewidth=0.8, linestyle=':')
    ax2.axhline(0,        color='#444444', linewidth=0.6)

    for bx in buy_x:
        ax2.axvline(bx, color='#00e676', alpha=0.12, linewidth=1)
    for sx in sell_x:
        ax2.axvline(sx, color='#ff5252', alpha=0.12, linewidth=1)

    # x-axis: show date labels every ~20 bars
    step  = max(1, len(x) // 8)
    ticks = x[::step]
    lbls  = [dates[i].strftime('%b %y') for i in range(0, len(dates), step)]
    ax2.set_xticks(ticks)
    ax2.set_xticklabels(lbls, rotation=30, ha='right', fontsize=7)

    ax2.set_ylim(-TMO_LENGTH - 0.5, TMO_LENGTH + 0.5)
    ax2.set_ylabel('TMO', color='#cccccc', fontsize=9)
    ax2.legend(facecolor='#1a1d23', edgecolor='#444', labelcolor='white',
               fontsize=7, loc='upper left', ncol=2)
    ax2.grid(color='#222222', linewidth=0.5)

    plt.tight_layout()
    plt.show()


