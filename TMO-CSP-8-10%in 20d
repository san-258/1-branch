        return (v > 0).mean() * 100 if len(v) else float('nan')

    def avg(df, col='ret_5d'):
        v = df[col].dropna()
        return v.mean() if len(v) else float('nan')

    print(f"{sym:<7}  {len(buy_r):>5}  {len(sell_r):>6}  "
          f"{wr(buy_r):>9.1f}%  {wr(sell_r):>10.1f}%  "
