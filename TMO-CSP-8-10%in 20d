# ── 2. TMO CALCULATION ───────────────────────────────────────────────────────
def ema(series: pd.Series, span: int) -> pd.Series:
    """Standard EMA — matches TOS ExpAverage (adjust=False)."""
    return series.ewm(span=span, adjust=False).mean()


def calc_tmo(df: pd.DataFrame):
    """
    Faithful Python port of the Mobius TMO thinkScript:

        data = fold i = 0 to length
               with s
               do s + (if close > getValue(open, i) then 1
                       else if close < getValue(open, i) then -1
                       else 0)

    getValue(open, i) returns open[i bars back].  i=0 → current bar's open.
    So for each bar t we compare close[t] to open[t], open[t-1], …, open[t-13].

        EMA5   = EMA(data,  calcLength=5)
        Main   = EMA(EMA5,  smoothLength=3)
        Signal = EMA(Main,  smoothLength=3)
    """
    close  = df['Close'].values
    open_  = df['Open'].values
    n      = len(close)

    # --- fold ---------------------------------------------------------------
    raw = np.full(n, np.nan)
    for t in range(TMO_LENGTH - 1, n):          # need at least TMO_LENGTH bars
        s = 0
        for i in range(TMO_LENGTH):             # i = 0 … 13  (14 comparisons)
            c = close[t]
            o = open_[t - i]                    # open i bars back
            if   c > o: s += 1
            elif c < o: s -= 1
        raw[t] = s
    # -------------------------------------------------------------------------

    raw_s  = pd.Series(raw, index=df.index)     # NaN for first 13 bars
    ema5   = ema(raw_s,  CALC_LENGTH)
    main   = ema(ema5,   SMOOTH_LENGTH)
    signal = ema(main,   SMOOTH_LENGTH)

    return main, signal


# ── 3. SIGNAL DETECTION ──────────────────────────────────────────────────────
def find_signals(main: pd.Series, signal: pd.Series):
    """
    BUY  : Main crosses ABOVE Signal  (red→green)
           AND within last ZONE_LOOKBACK bars, Main was below OS_LEVEL (-10)

    SELL : Main crosses BELOW Signal  (green→red)
           AND within last ZONE_LOOKBACK bars, Main was above OB_LEVEL (+10)

    The rolling window for "was in zone" is inclusive of the current bar,
    so the cross can happen on the same bar Main touched the zone — though
    in practice the EMA smoothing means there's usually a gap of 1-3 bars.
    """
    bull_cross = (main.shift(1) <= signal.shift(1)) & (main > signal)
    bear_cross = (main.shift(1) >= signal.shift(1)) & (main < signal)

    was_oversold   = main.rolling(ZONE_LOOKBACK, min_periods=1).min()  < OS_LEVEL
    was_overbought = main.rolling(ZONE_LOOKBACK, min_periods=1).max()  > OB_LEVEL

    buy_sigs  = bull_cross & was_oversold
    sell_sigs = bear_cross & was_overbought

    return buy_sigs, sell_sigs


# ── 4. PER-SYMBOL BACKTEST ───────────────────────────────────────────────────
def backtest_symbol(symbol: str):
    df = yf.download(symbol, start=START_DATE, end=END_DATE,
                     auto_adjust=True, progress=False)
    if df.empty or len(df) < 60:
        return symbol, None

    # yfinance sometimes returns MultiIndex columns for a single ticker
    if isinstance(df.columns, pd.MultiIndex):
        df.columns = df.columns.get_level_values(0)

    # Ensure numeric types
    df = df[['Open','High','Low','Close','Volume']].copy()
    df = df.apply(pd.to_numeric, errors='coerce').dropna()

    main, signal = calc_tmo(df)
    buy_sigs, sell_sigs = find_signals(main, signal)

    close = df['Close']
    records = []

    for sig_type, sigs in [('BUY', buy_sigs), ('SELL', sell_sigs)]:
        for date in sigs[sigs].index:
            idx = df.index.get_loc(date)
            entry = close.iloc[idx]
            rec   = {
                'symbol'     : symbol,
                'date'       : date,
                'signal'     : sig_type,
                'entry_price': round(entry, 4),
                'main_val'   : round(main[date], 3),
                'signal_val' : round(signal[date], 3),
            }
            for fwd in FORWARD_BARS:
                fi = idx + fwd
                if fi < len(df):
                    future = close.iloc[fi]
                    raw_ret = (future - entry) / entry
                    # for SELL signals we measure SHORT direction
                    ret = raw_ret if sig_type == 'BUY' else -raw_ret
                    rec[f'ret_{fwd}d'] = round(ret * 100, 2)
                else:
                    rec[f'ret_{fwd}d'] = np.nan
            records.append(rec)

    results_df = pd.DataFrame(records) if records else pd.DataFrame()
    return symbol, {'df': df, 'main': main, 'signal': signal,
                    'buy_sigs': buy_sigs, 'sell_sigs': sell_sigs,
                    'results': results_df}


